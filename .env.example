# NM NEXUS — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.

# ───────────────────────────────────────────────
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# ───────────────────────────────────────────────
# Public values — safe to expose in the browser. RLS protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only — used by Next.js API routes / server components.
# NEVER prefix with NEXT_PUBLIC_. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database direct connection — used ONLY by Prisma/migration scripts.
# NEVER expose in the browser bundle.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ───────────────────────────────────────────────
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# ───────────────────────────────────────────────
# Server-only — NEVER expose the secret to the browser.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Public client ID — safe for browser (Google Identity Services / One Tap).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ───────────────────────────────────────────────
# WebRTC (https://www.metered.ca/tools/openrelay/ or self-hosted coturn)
# ───────────────────────────────────────────────
# STUN is free and stateless. TURN relays media and costs bandwidth.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URLS=turn:your-turn-server.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# ───────────────────────────────────────────────
# App
# ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=NM NEXUS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────────────────────────────────────────
# Cloudflare (deployment only — local dev does not need these)
# ───────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# ───────────────────────────────────────────────
# GitHub (CI/CD only — not required for local dev)
# ───────────────────────────────────────────────
GITHUB_TOKEN=your-github-pat
